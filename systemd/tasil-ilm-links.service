[Unit]
Description=Tasil ilm study program: monthly broken-link check

[Service]
Type=oneshot
WorkingDirectory=%h/dev/site-tasil-ilm-study-program
ExecStart=/usr/bin/env node scripts/check-links.mjs --alert
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=en_US.UTF-8
StandardOutput=append:%L/tasil-ilm-links.log
StandardError=inherit
